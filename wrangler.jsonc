{
  // ===========================================================================
  // إعداد النشر على Cloudflare Workers (الأصول الثابتة)
  // ===========================================================================
  // الاسم يجب أن يطابق اسم العامل المنشور، وإلا أنشأ wrangler عاملاً جديداً.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admh-inspection-reporting-system",
  "compatibility_date": "2026-10-06",

  "observability": {
    "enabled": true
  },

  "assets": {
    // المجلد الجذر — والتطبيق بلا خطوة بناء، فملفاته تُخدَم كما هي.
    "directory": ".",
    // لا صفحة 404 مخصّصة: التطبيق صفحة واحدة وكل التنقل داخلي.
    "not_found_handling": "none"
  }

  // ---------------------------------------------------------------------------
  // لماذا لا نضع سكربت "deploy" في package.json؟
  // ---------------------------------------------------------------------------
  // لأن وجوده يجعل Cloudflare يكتشف المشروع كـ«Worker» ويُشغّل الخطوات
  // التفاعلية، ومنها `bun install` الذي يُنشئ node_modules داخل مجلد الأصول
  // فيفشل الرفع بحجم الملفات. النشر يبقى من إعدادات Cloudflare كما كان.
}
