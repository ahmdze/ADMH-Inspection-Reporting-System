# =============================================================================
# تقارير العمل الحقيقية — لا تدخل المستودع أبداً
# =============================================================================
نماذج/
*.docx
*.pdf
*.xlsx
*.jpg
*.jpeg
*.png
!icons/*.png

# مخرجات الاختبار
_tools/*.docx
_tools/*.pdf
_tools/*.checks.json
# مخرجات بصرية مؤقتة
_tools/shots/

# =============================================================================
# مشتقات التقارير الحقيقية — حذف الأصل لا يكفي!
# =============================================================================
# العطل الذي حدث: حُذف مجلد «نماذج» (ملفات Word)، لكن **بقيت مشتقاته**:
# نصوص مستخرجة، وصور مرسومة من المستندات، وأدوات استخراج. فبقيت البيانات
# الحقيقية في المستودع من باب آخر. هذه الأنماط تمنع تكرار ذلك.
_tools/samples_dump.txt
_tools/review_pdf.txt
_tools/final-render/
_tools/final2/
_tools/dump_docx.py
# أي استخراج نصوص أو صور مرسومة من مستندات، بأي اسم
_tools/*dump*.txt
_tools/*extract*.txt
_tools/*-render/
_tools/render*/
*_samples.txt
*dump*.txt

# مجلد أُنشئ بالخطأ (الصحيح .git/hooks/)
/git/

# ملف تعريف Chrome المؤقّت للاختبارات
.chrome-tmp/

# مخرجات اختبارات مؤقتة
_t_*.html
_probe*.html
_vis_probe.html
_dom_probe.html
view_probe.html
